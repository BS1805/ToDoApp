@model ToDoApp.FrontEnd.Models.PagedListViewModel<ToDoApp.FrontEnd.Models.TaskViewModel>

@{
    ViewData["Title"] = "Tasks by Status";
    var statusId = ViewData["StatusId"] ?? 1; 
    var pageSize = ViewData["PageSize"] ?? 10;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Tasks by Status</h2>
        <div>
            <a asp-action="Dashboard" class="btn btn-outline-info me-2">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-list-task"></i> All Tasks
            </a>
            <a asp-action="Create" class="btn btn-outline-success">
                <i class="bi bi-plus-circle"></i> Create Task
            </a>
        </div>
    </div>

    <form id="filterForm" class="row g-3 align-items-center mb-4">
        <div class="col-auto">
            <label for="pageSize" class="col-form-label">Page Size:</label>
        </div>
        <div class="col-auto">
            <input type="number" id="pageSize" name="pageSize" class="form-control" value="@pageSize" min="1" />
        </div>
        <input type="hidden" id="statusId" name="statusId" value="@statusId" />
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Apply</button>
        </div>
    </form>

    <div id="tasksContainer" class="row"></div>
    <div id="paginationContainer" class="container"></div>
</div>

@section Scripts {
    <script>
        window.TasksByStatusConfig = {
            statusId: '@statusId',
            pageSize: '@pageSize',
            apiUrl: '@Url.Action("TasksByStatusApi", "ToDo")'
        };
    </script>
    <script src="~/js/tasks-by-status.js"></script>
}
